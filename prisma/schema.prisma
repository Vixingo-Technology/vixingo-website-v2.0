generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(EMPLOYEE)
  avatarUrl    String?
  bio          String?
  linkedin     String?
  github       String?
  twitter      String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  isPublic     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  tasks        Task[]    @relation("AssignedTo")
  createdTasks Task[]    @relation("CreatedBy")
  blogPosts    BlogPost[]
}

enum Role {
  EMPLOYEE
  SENIOR_EMPLOYEE
  ADMIN
}

model BlogPost {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String
  coverImage  String?
  excerpt     String?
  category    String
  tags        String[]
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  seoTitle    String?
  seoDesc     String?
  ogImage     String?
  readTime    Int?
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model PortfolioItem {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  shortDesc    String
  fullDesc     String?
  coverImage   String
  images       String[]
  category     String
  techStack    String[]
  externalUrl  String?
  isFeatured   Boolean  @default(false)
  isPublic     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CaseStudy {
  id            String         @id @default(cuid())
  title         String
  clientName    String?
  industry      String?
  services      String[]
  problem       String
  approach      String
  solution      String
  results       String
  internalNotes String?
  images        String[]
  tags          String[]
  visibility    CaseVisibility @default(ALL_EMPLOYEES)
  status        CaseStatus     @default(DRAFT)
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum CaseVisibility {
  ADMIN_ONLY
  SENIOR_AND_ADMIN
  ALL_EMPLOYEES
}

enum CaseStatus {
  DRAFT
  INTERNAL_REVIEW
  PUBLISHED_INTERNAL
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String?
  priority     Priority   @default(MEDIUM)
  status       TaskStatus @default(TODO)
  dueDate      DateTime?
  isRecurring  Boolean    @default(false)
  recurPattern String?
  tags         String[]
  assignedToId String
  assignedTo   User       @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User       @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  ARCHIVED
}

model Waitlist {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  source      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())
}

model ContactSubmission {
  id              String           @id @default(cuid())
  name            String
  email           String
  company         String?
  serviceInterest String
  budget          String?
  message         String
  status          SubmissionStatus @default(UNREAD)
  createdAt       DateTime         @default(now())
}

enum SubmissionStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model ChatDocument {
  id        String   @id @default(cuid())
  source    String
  sourceId  String?
  content   String
  embedding Float[]
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InviteToken {
  id        String   @id @default(cuid())
  email     String
  name      String
  role      Role     @default(EMPLOYEE)
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
