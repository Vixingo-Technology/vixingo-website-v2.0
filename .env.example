# ─── Vixingo Environment Variables ────────────────────────────────
# Copy this to .env.local and fill in values

# ─── Database ─────────────────────────────────────────────────────
# Prisma 7 reads datasource URLs from prisma.config.ts.
# DATABASE_URL is used by the app/runtime (recommended: Supabase pooler, port 6543).
# DIRECT_URL is optional and used by prisma.config.ts for CLI/migrations (port 5432).
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string-in-production"

# ─── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@vixingo.com"

# ─── OpenAI (for RAG chatbot, optional) ──────────────────────────
OPENAI_API_KEY=""

# ─── File Storage (Supabase, optional) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ─── App Settings ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Vixingo"
