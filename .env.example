# ─── Vixingo Environment Variables ────────────────────────────────
# Copy this to .env.local and fill in values

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/vixingo?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string-in-production"

# ─── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@vixingo.com"

# ─── OpenAI (for RAG chatbot, optional) ──────────────────────────
OPENAI_API_KEY=""

# ─── File Storage (Supabase, optional) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ─── App Settings ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Vixingo"
